{
  "schema_version": "mentorflow.integration-manifest.v1",
  "delivery_id": "mentorflow-live-demo-05-review-product-v1",
  "product": "Review Product Experience",
  "status": "integration_compatible_standalone",
  "entrypoints": {
    "api_app": "app.review_product_v1.api:app",
    "api_base": "http://127.0.0.1:8001/api/review",
    "frontend": "/review-demo.html",
    "frontend_api_env": "VITE_REVIEW_API_BASE"
  },
  "runtime_dependency": {
    "module": "app.teaching.review_campaign_v2",
    "contract": "ReviewCampaignRuntime",
    "copied": false
  },
  "adapter_seams": {
    "trusted_question_bank": "TrustedQuestionBankPort.select_trusted_items",
    "evaluator": "EvaluatorV2.evaluate",
    "review_memory": [
      "ReviewCampaignMemoryPort.read_due_priority",
      "ReviewCampaignMemoryPort.write_review_observation_proposal"
    ],
    "student_progress": "StudentProgressPort.load_student_progress",
    "budget": "ReviewExecutionBudgetPort.authorize",
    "teacher_explanation": "TeacherExplanationPort.explain (explicit why or policy only)"
  },
  "offline_demo": {
    "concept_count": 10,
    "question_count": 20,
    "fixed_round_count": 3,
    "provider_key_required": false,
    "provider_calls_expected": 0,
    "fsrs_can_change_fixed_round_count": false
  },
  "integration_policy": {
    "central_router_modified": false,
    "mounting_deferred": true,
    "reason": "LIVE-DEMO-05 requires an independent API module and scope fence",
    "mount_example": "uvicorn app.review_product_v1.api:app --host 127.0.0.1 --port 8001"
  },
  "privacy_contract": {
    "pre_submit_forbidden_fields": [
      "rubric",
      "accepted_answers",
      "evidence",
      "expected_answer",
      "explanation"
    ],
    "post_submit_reference_answer_allowed": true,
    "revealed_retry_counts_as_independent_pass": false
  },
  "verification": {
    "backend": "python -m pytest backend/tests/test_review_product_v1.py backend/tests/test_review_campaign_v2.py backend/tests/test_review_session_v1.py -q",
    "frontend": "npm --prefix frontend test -- --run src/test/review_demo.test.tsx",
    "build": "npm --prefix frontend run build",
    "browser": "npm --prefix frontend exec -- playwright test --config=playwright.review.config.ts"
  }
}
