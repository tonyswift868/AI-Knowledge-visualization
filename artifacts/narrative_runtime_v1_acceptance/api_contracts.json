{
  "request_id": "Every new Narrative API response includes request_id; errors use the existing error envelope.",
  "routes": [
    {"method": "GET", "path": "/api/story-packs", "returns": "{request_id, story_packs}"},
    {"method": "GET", "path": "/api/story-packs/{story_pack_id}", "returns": "{request_id, story_pack}"},
    {"method": "POST", "path": "/api/workspaces/{workspace_id}/campaigns", "body": "{story_pack_id?}", "returns": "public Campaign"},
    {"method": "GET", "path": "/api/campaigns/{campaign_id}", "returns": "public Campaign"},
    {"method": "POST", "path": "/api/campaigns/{campaign_id}/advance", "body": "{action, expected_revision?, idempotency_key?}", "returns": "public Campaign"},
    {"method": "POST", "path": "/api/campaigns/{campaign_id}/choices", "body": "{choice_id, expected_revision?, idempotency_key?}", "returns": "public Campaign"},
    {"method": "POST", "path": "/api/campaigns/{campaign_id}/messages", "body": "{message, intent?, lesson_id?, session_id?}", "returns": "{route, message, grounding?, persona?}"},
    {"method": "POST", "path": "/api/campaigns/{campaign_id}/learning-events", "body": "{event_type, source_type, source_id, payload?, expected_revision?, idempotency_key?}", "returns": "{duplicate, event, campaign}"},
    {"method": "GET", "path": "/api/campaigns/{campaign_id}/history", "returns": "{request_id, events}"},
    {"method": "GET", "path": "/api/campaigns/{campaign_id}/available-actions", "returns": "{request_id, actions, choices, learning_gate}"},
    {"method": "POST", "path": "/api/campaigns/{campaign_id}/voice/synthesize", "body": "{text, voice_profile_id?, provider?, style?}", "returns": "text fallback contract"}
  ],
  "error_codes": ["STORY_PACK_NOT_FOUND", "STORY_PACK_CHECKSUM_MISMATCH", "LEARNING_GATE_BLOCKED", "CAMPAIGN_REVISION_CONFLICT", "MAIN_ANCHOR_SKIPPED", "LEARNING_EVENT_SOURCE_UNTRUSTED", "WORKSPACE_SCOPE_VIOLATION"]
}
