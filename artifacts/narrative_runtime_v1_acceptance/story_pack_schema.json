{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MentorFlow Story Pack V1 file contract",
  "type": "object",
  "required": ["manifest", "story_bible", "characters", "scenes", "learning_bindings", "asset_manifest", "voice_manifest"],
  "properties": {
    "manifest": {"type": "object", "required": ["story_pack_id", "version", "title", "source_work", "source_version", "language", "minimum_runtime_version", "supported_duration_days", "content_rating", "entry_scene_id", "ending_scene_ids", "checksum", "created_at", "provenance_notes"]},
    "story_bible": {"type": "object", "required": ["immutable_facts", "timeline_rules", "world_rules", "main_plot_anchors", "forbidden_reveals", "ending_conditions", "allowed_small_adaptations", "forbidden_adaptations"]},
    "characters": {"type": "object", "description": "Each character file has public identity, hidden fields, speech rules, teaching capability and asset/voice references."},
    "scenes": {"type": "object", "description": "Each scene has scene_type, story_order, fixed lines, references, choices, next rules, safe slots, optional learning_gate_ref and immutable."},
    "learning_bindings": {"type": "object", "required": ["bindings"]},
    "asset_manifest": {"type": "object", "required": ["assets"]},
    "voice_manifest": {"type": "object", "required": ["voice_profiles"]}
  }
}
