# Public, non-secret inputs for the ACCOUNT_CORE_MVP Compose profile.
MENTORFLOW_COMPOSE_PROJECT=mentorflow-account-core-mvp
MENTORFLOW_PUBLIC_ORIGIN=https://mentorflow.example.com
MENTORFLOW_PUBLIC_HOSTNAME=mentorflow.example.com
MENTORFLOW_DATA_DIR=/opt/mentorflow/data/account-core-mvp
MENTORFLOW_SECRETS_DIR=/opt/mentorflow/secrets
POSTGRES_IMAGE=postgres@sha256:REPLACE_WITH_64_LOWERCASE_HEX
KEYCLOAK_IMAGE=ghcr.io/example/mentorflow-keycloak@sha256:REPLACE_WITH_64_LOWERCASE_HEX
MENTORFLOW_BACKEND_IMAGE=ghcr.io/example/mentorflow-backend@sha256:REPLACE_WITH_64_LOWERCASE_HEX
MENTORFLOW_ACCOUNT_CORE_EDGE_IMAGE=ghcr.io/example/mentorflow-account-core-edge@sha256:REPLACE_WITH_64_LOWERCASE_HEX
