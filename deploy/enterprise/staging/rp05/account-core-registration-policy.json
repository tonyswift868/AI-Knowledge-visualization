{
  "schema": "mentorflow.mvp-registration.v1",
  "deployment_profile": "account-core-mvp",
  "realm": "mentorflow",
  "keycloak_version": "26.7.3",
  "realm_patch": {
    "registrationAllowed": true,
    "registrationEmailAsUsername": false,
    "verifyEmail": false,
    "resetPasswordAllowed": false
  },
  "optional_profile_attributes": ["email", "firstName", "lastName"],
  "nondefault_required_actions": ["VERIFY_EMAIL"],
  "preserve_verify_profile": true
}
