{
  "project": "MentorFlow",
  "exclude": [".local/**", ".git/**", "**/.venv/**", "**/node_modules/**", "**/dist/**", "**/__pycache__/**", "**/.pytest_cache/**", "**/target/**", "**/vendor/**", "**/release-keys/**", "**/credentials/**", "**/auth.json", "docs/project/WORKFLOW.md", "scripts/release/inputs/7zr.exe", "**/*.jar", "**/*.key", "**/*.p12", "**/*.pfx"],
