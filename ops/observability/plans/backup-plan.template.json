{
  "schema_version": "mentorflow.enterprise-recovery-plan.v1",
  "backup_id": "staging-YYYYMMDDTHHMMSSZ",
  "backup_root": "/srv/mentorflow-backups",
  "postgres": {
    "host": "127.0.0.1",
    "port": 5432,
    "database": "mentorflow",
    "username": "mentorflow_backup",
    "password_env": "MENTORFLOW_BACKUP_POSTGRES_PASSWORD"
  },
  "keycloak_database": {
    "host": "127.0.0.1",
    "port": 5432,
    "database": "keycloak",
    "username": "mentorflow_backup",
    "password_env": "MENTORFLOW_BACKUP_KEYCLOAK_PASSWORD"
  },
  "object_source_root": "/srv/mentorflow-objects",
  "keycloak_realm_export": "/srv/mentorflow-keycloak-export/realm.json",
  "pg_dump_binary": "pg_dump"
}
