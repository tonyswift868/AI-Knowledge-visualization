{
  "schema_version": "mentorflow.enterprise-restore-drill.v1",
  "environment": "staging",
  "environment_id": "disposable-restore-001",
  "disposable_environment": true,
  "disposable_root": "/srv/mentorflow-disposable/restore-001",
  "marker_file": "/srv/mentorflow-disposable/restore-001/.mentorflow-disposable.json",
  "approved_tool_root": "/opt/mentorflow/verification-tools",
  "seed_command": ["/opt/mentorflow/verification-tools/integrity-snapshot", "seed"],
  "destroy_command": ["/opt/mentorflow/verification-tools/destroy-disposable", "restore-001"],
  "compare_command": ["/opt/mentorflow/verification-tools/integrity-snapshot", "read"],
  "backup": {
    "backup_id": "disposable-restore-001-backup",
    "backup_root": "/srv/mentorflow-backups",
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "database": "mentorflow_disposable_restore_001",
      "username": "mentorflow_backup",
      "password_env": "MENTORFLOW_BACKUP_POSTGRES_PASSWORD"
    },
    "keycloak_database": {
      "host": "127.0.0.1",
      "port": 5432,
      "database": "keycloak_disposable_restore_001",
      "username": "mentorflow_backup",
      "password_env": "MENTORFLOW_BACKUP_KEYCLOAK_PASSWORD"
    },
    "object_source_root": "/srv/mentorflow-disposable/restore-001/source/objects",
    "keycloak_realm_export": "/srv/mentorflow-disposable/restore-001/source/keycloak-realm.json"
  },
  "restore": {
    "backup_directory": "/srv/mentorflow-backups/disposable-restore-001-backup",
    "postgres": {
      "host": "127.0.0.1",
      "port": 5432,
      "database": "mentorflow_disposable_restore_001",
      "username": "mentorflow_backup",
      "password_env": "MENTORFLOW_BACKUP_POSTGRES_PASSWORD"
    },
    "keycloak_database": {
      "host": "127.0.0.1",
      "port": 5432,
      "database": "keycloak_disposable_restore_001",
      "username": "mentorflow_backup",
      "password_env": "MENTORFLOW_BACKUP_KEYCLOAK_PASSWORD"
    },
    "object_restore_root": "/srv/mentorflow-disposable/restore-001/restored/objects",
    "keycloak_realm_restore": "/srv/mentorflow-disposable/restore-001/restored/keycloak-realm.json"
  }
}
