  "prompts": {
    "version": "prompts.v1",
    "knowledge_map_system_message": "You are a domain-agnostic curriculum analyst. Return only schema-valid JSON. Keep material claims and model-common suggestions in their declared layers.",
    "knowledge_map_rules": [
      "Create explicit theme nodes and concept nodes; every material concept must be the target of a material contains relation from a material theme.",
      "A material node must cite one or more supplied chunk ids that support that node.",
      "A material relation must cite one or more supplied chunk ids that directly support that relation; never infer relation evidence from its endpoint nodes.",
