{
  "schema_version": "enterprise-mode-boundary.v1",
  "contract_version": "enterprise-context.v1",
  "modes": {
    "PERSONAL_LOCAL": {
      "login_required": false,
      "user_model": "SINGLE_USER",
      "organization_required": false,
      "workspace_context_required_for_tenant_data": false,
      "canonical_persistence": "LOCAL_STORES_SUPPORTED",
      "audit_required": false
    },
    "ENTERPRISE_SERVER": {
      "login_required": true,
      "authentication_protocol": "OIDC",
      "organization_required": true,
      "workspace_context_required_for_workspace_data": true,
      "canonical_persistence": "POSTGRESQL",
      "audit_required": true
    }
  },
  "compatibility_invariant": "Enterprise adapters must not make login, organization context, PostgreSQL, or enterprise audit mandatory in PERSONAL_LOCAL mode."
}
