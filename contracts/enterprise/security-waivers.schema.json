{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mentorflow.local/contracts/enterprise/security-waivers.v1.schema.json",
  "title": "EnterpriseSecurityWaiverRegistry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "waivers"],
  "properties": {
    "schema": {"const": "mentorflow.enterprise-security-waivers.v1"},
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "scanner", "finding", "scope", "reason", "owner", "expires_on"],
        "properties": {
          "id": {"type": "string", "pattern": "^ESW-[0-9]{4}-[0-9]{3,}$"},
          "scanner": {"type": "string", "minLength": 2},
          "finding": {"type": "string", "minLength": 2},
          "scope": {"type": "string", "minLength": 2},
          "reason": {"type": "string", "minLength": 12},
          "owner": {"type": "string", "minLength": 2},
          "expires_on": {"type": "string", "format": "date"}
        }
      }
    }
  }
}
