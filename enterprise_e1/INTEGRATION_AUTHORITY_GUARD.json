{
  "schema_version": "enterprise-integration-authority-guard.v1",
  "effective_at": "2026-08-26T20:25:56+08:00",
  "authority": {
    "WORKER_NEW_TASK_ASSIGNMENT_AUTHORITY": "ARCHITECT_ONLY",
    "A_DIRECT_NEW_FEATURE_DISPATCH": "DISABLED",
    "INTEGRATION_REVIEW_FEEDBACK_AUTHORITY": "A_ENABLED",
    "RETURN_TO_OWNER_GUIDANCE": "A_ENABLED",
    "A_INTEGRATION_REVIEW_FEEDBACK": "ENABLED",
    "A_RETURN_TO_OWNER_REPAIR_GUIDANCE": "ENABLED",
    "A_PERIODIC_WORKER_CHAT": "DISABLED",
    "NO_PERIODIC_AGENT_CHAT": true,
    "NO_WORKER_OFFICE_MUTATION_BY_A": true
  },
  "role_boundaries": {
    "ARCHITECT": [
      "roadmap",
      "new_tasks",
      "worker_domain",
      "task_sizing",
      "product_priorities"
    ],
    "A": [
      "delivery_review",
      "exact_commit_integration",
      "request_in_scope_changes",
      "exact_repair_feedback",
      "shared_contracts",
      "migration_coordination",
      "dependency_mutation",
      "integration_only_wiring",
      "combined_gates",
      "integration_log_and_registry"
    ],
    "B": [
      "provisioning",
      "dependency_epoch",
      "worker_offices",
      "environment"
    ],
    "WORKERS": [
      "implementation",
      "owner_fixes",
      "tests"
    ],
    "08": [
      "qa"
    ]
  },
  "review_feedback": {
    "allowed_only_after_actual_delivery_review": true,
    "one_way_precise_feedback_allowed": true,
    "periodic_or_status_chat_forbidden": true,
    "allowed_kinds": [
      "INTEGRATION_REVIEW_FEEDBACK",
      "RETURN_TO_OWNER_REPAIR_REQUEST"
    ],
    "allowed_triggers": [
      "test_failure",
      "contract_drift",
      "forbidden_path_modification",
      "incorrect_implementation",
      "security_problem",
      "migration_conflict",
      "integration_incompatibility",
      "missing_receipt",
      "missing_test_coverage",
      "dependency_mismatch",
      "regression",
      "performance_gate_failure",
      "tenant_isolation_failure",
      "authorization_failure",
      "rls_failure",
      "acceptance_violating_observability_gap",
      "other_failure_within_original_delivery_scope"
    ],
    "required_fields": [
      "DELIVERY_ID",
      "WORKER_ID",
      "AUDIT_RESULT",
      "WHY",
      "FIX_SCOPE",
      "FILES",
      "TESTS",
      "DO_NOT_TOUCH",
      "REVIEW_AFTER_FIX"
    ],
    "optional_diagnostic_fields": [
      "FAILED_COMMIT",
      "FAILED_PATH",
      "FAILED_TEST",
      "EXPECTED_BEHAVIOR",
      "ACTUAL_BEHAVIOR",
      "ROOT_CAUSE_IF_KNOWN"
    ],
    "review_after_fix": "REQUIRED"
  },
  "return_to_owner": {
    "result": "RETURN_TO_OWNER",
    "must_identify_exact_delivery_failure": true,
    "minimal_fix_scope_only": true,
    "new_delivery_fence_receipt_required_after_fix": true,
    "scope_expansion_forbidden": true
  },
  "integration_outcomes": [
    "MERGED",
    "RETURN_TO_OWNER",
    "CONTRACT_CHANGE_REQUIRED",
    "DEPENDENCY_CHANGE_REQUIRED",
    "PENDING_QA"
  ],
  "forbidden_by_a": [
    "new_product_feature",
    "next_wave_product_route",
    "new_module_development",
    "unrelated_optimization",
    "worker_office_branch_or_rebind",
    "worker_domain_reassignment",
    "review_scope_expansion",
    "forcing_out_of_scope_improvement_into_current_delivery"
  ],
  "out_of_scope_improvement_disposition": "ARCHITECT_FOLLOWUP_SUGGESTION_ONLY",
  "merge_behavior": {
    "pass_result": "MERGED",
    "worker_message_required_on_pass": false,
    "integration_result_only": true
  },
  "written_by": "Core-v2 Enterprise Integration Maintainer"
}
