{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MentorFlow Narrative Candidate Index V2",
  "type": "object",
  "required": [
    "catalog_id",
    "record_tier",
    "library_version",
    "title",
    "source_platform",
    "narrative_signals",
    "heuristic_scores",
    "curation_status",
    "plot_verification_status",
    "story_pack_status"
  ],
  "properties": {
    "catalog_id": {
      "type": "string"
    },
    "record_tier": {
      "const": "candidate_index"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "narrative_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "heuristic_scores": {
      "type": "object"
    },
    "candidate_rank": {
      "type": "integer",
      "minimum": 1
    }
  },
  "additionalProperties": true
}