{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MentorFlow Narrative DNA Entry V1",
  "type": "object",
  "required": [
    "id",
    "title_zh",
    "title_original",
    "medium",
    "source_urls",
    "verified_premise",
    "narrative_families",
    "player_position",
    "relationship_engine",
    "emotional_promise",
    "canonical_plot_spine",
    "learning_fit",
    "safe_adaptations",
    "immutable_core",
    "adaptation_risks",
    "asset_profile",
    "scores",
    "story_pack_status"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "source_urls": {
      "type": "array",
      "items": {
        "type": "string",
        "format": "uri"
      },
      "minItems": 1
    },
    "narrative_families": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "canonical_plot_spine": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 3
    },
    "scores": {
      "type": "object",
      "required": [
        "story_quality",
        "mentorflow_fit",
        "first_pass_review_fit",
        "interaction_fit",
        "adaptation_risk"
      ]
    }
  },
  "additionalProperties": true
}